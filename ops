g `None` to `diff`, while still triggering the `diff` when annotating.","files":null},{"type":5,"author":{"id":"cf7a0bdf96b5195bf3052274368f463c7410f7a8"},"timestamp":1496681916,"metadata":{"github-id":"MDEyOkxhYmVsZWRFdmVudDExMTAzMTU5OTk="},"added":["fix-implemented"],"removed":[]},{"type":4,"author":{"id":"819663238374c863923453c36b916c251f565216"},"timestamp":1496833194,"metadata":{"github-id":"MDExOkNsb3NlZEV2ZW50MTExMzQzNDk0Ng=="},"status":2}]}