{"version":1,"ops":[{"type":1,"author":{"id":"cf7a0bdf96b5195bf3052274368f463c7410f7a8"},"timestamp":1519663274,"metadata":{"github-id":"MDU6SXNzdWUzMDAzMTAxNTY=","github-url":"https://github.com/datalad/datalad/issues/2233","origin":"github"},"title":"`search` needs option to requery the full metadata set of search hits","message":"The default \"maybe i find something in the dumpster\" search mode, but also the ultra-clever tailored search indices will not necessarily return results that contain ALL available metadata for a search hit. This limits the utility of output reporting. `search` should requery aggregated metadata for search hits to enable full-scale result reporting. As this will only be done for hits, the performance impact will be tolerable in most cases.","files":null}]}